public class MainActivity extends Activity {
    // Brand palette follows the university's purple/gold identity.
    private static final int PURPLE=Color.rgb(92,42,115), PURPLE_DARK=Color.rgb(61,24,79), GOLD=Color.rgb(199,164,91);
    private static final int BG=Color.rgb(246,244,248), CARD=Color.WHITE, INK=Color.rgb(34,27,38), MUTED=Color.rgb(104,91,109);
    private static final int GREEN=Color.rgb(45,145,78), AMBER=Color.rgb(203,153,35), RED=Color.rgb(190,67,67), BLUE=Color.rgb(71,105,177), LINE=Color.rgb(228,220,232);

    // Control traffic is isolated from status polling and file I/O.
    // STOP/PAUSE must never sit behind a slow export/import or a timed-out poll.
    private final ExecutorService controlIo=Executors.newSingleThreadExecutor();
    private final ExecutorService pollIo=Executors.newSingleThreadExecutor();
    private final ExecutorService fileIo=Executors.newSingleThreadExecutor();
    private final Handler ui=new Handler(Looper.getMainLooper());
    private final AtomicBoolean pollInFlight=new AtomicBoolean(false);
    private final AtomicBoolean commandInFlight=new AtomicBoolean(false);
    private final AtomicInteger pendingCommands=new AtomicInteger(0);
    private volatile boolean running=true;
    private volatile boolean connected=false;
    private volatile Network selectedWifiNetwork;
    private int failedPolls=0;
    private long lastLatency=0;
    private ConnectivityManager connectivity;
    private ConnectivityManager.NetworkCallback wifiCallback;

    private LinearLayout appRoot, content, workScreen, calScreen, serviceScreen, pathContainer, moduleList, navBar;
    private TextView connectionPill, stateTitle, stateSub, healthText, calStatusTop, calStatus, calTrack, serviceSummary, serviceWarning, eventText;
    private AuscultationMapView mapView;
